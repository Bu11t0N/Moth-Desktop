{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Moth Desktop",
  "version": "0.3.2",
  "identifier": "org.mothvpn.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Мотылёк",
        "width": 1120,
        "height": 760,
        "minWidth": 800,
        "minHeight": 600,
        "backgroundColor": "#101113"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "resources": {
      "../.local/engines/win32-x64/xray.exe": "engines/xray.exe",
      "../.local/engines/win32-x64/sing-box.exe": "engines/sing-box.exe",
      "../engines.lock.json": "notices/engines.lock.json",
      "../THIRD_PARTY.md": "notices/THIRD_PARTY.md",
      "../LICENSE": "notices/LICENSE",
      "../licenses/": "notices/licenses/",
      "../docs/ENGINES.md": "notices/docs/ENGINES.md",
      "../docs/SERVICE.md": "notices/docs/SERVICE.md"
    },
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Moth Desktop development preview",
    "category": "Utility",
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
