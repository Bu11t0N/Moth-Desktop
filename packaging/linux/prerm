#!/bin/sh
set -eu
case "${1:-}" in
  remove|upgrade|deconfigure|failed-upgrade)
    if pgrep -x moth-desktop >/dev/null; then
      echo 'Exit Moth Desktop before removing or upgrading the package.' >&2
      exit 1
    fi
    deb-systemd-invoke stop moth-desktop.service >/dev/null
    ;;
esac
exit 0
