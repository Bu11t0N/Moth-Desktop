#!/bin/sh
set -eu
case "${1:-}" in
  remove)
    systemctl daemon-reload
    # The packaged network-manager drop-ins are now gone; stopping this
    # completed oneshot no longer propagates to the user's network manager.
    deb-systemd-invoke stop moth-egress-guard.service >/dev/null
    deb-systemd-helper mask moth-desktop.service >/dev/null
    deb-systemd-helper mask moth-egress-guard.service >/dev/null
    ;;
  purge)
    deb-systemd-helper purge moth-desktop.service >/dev/null
    deb-systemd-helper unmask moth-desktop.service >/dev/null
    deb-systemd-helper purge moth-egress-guard.service >/dev/null
    deb-systemd-helper unmask moth-egress-guard.service >/dev/null
    systemctl daemon-reload
    ;;
esac
# Profile secrets belong to the user's Secret Service. Never traverse homes,
# delete keyring items or remove unknown installation files, even on purge.
exit 0
