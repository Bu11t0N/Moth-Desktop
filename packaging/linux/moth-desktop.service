[Unit]
Description=Moth Desktop VPN service
Requires=systemd-resolved.service
After=network.target systemd-resolved.service

[Service]
Type=simple
ExecStart=/usr/lib/moth-desktop/moth-service --service
ExecStopPost=/usr/lib/moth-desktop/moth-service --cleanup-network
Restart=on-failure
RestartSec=2
TimeoutStopSec=15
KillMode=control-group
RuntimeDirectory=moth-desktop
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=restart
UMask=0077
User=root
Group=root
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/run/moth-desktop
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
DevicePolicy=closed
DeviceAllow=/dev/net/tun rw

[Install]
WantedBy=multi-user.target
