[Unit]
Description=Moth Desktop VPN service
Requires=systemd-resolved.service
After=network.target systemd-resolved.service moth-egress-guard.service
Requires=moth-egress-guard.service

[Service]
Type=simple
ExecStart=/usr/lib/moth-desktop/moth-service --service
ExecStopPost=/usr/lib/moth-desktop/moth-service --cleanup-network
Restart=on-failure
RestartSec=2
TimeoutStopSec=15
KillMode=control-group
RuntimeDirectory=moth-desktop
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=restart
UMask=0077
User=root
Group=root
# Process-path routing needs read-only /proc traversal and ptrace access checks
# across desktop UIDs. No application-controlled paths or commands are executed.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_DAC_READ_SEARCH CAP_SYS_PTRACE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_DAC_READ_SEARCH CAP_SYS_PTRACE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/run/moth-desktop /var/lib/moth-desktop
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
DevicePolicy=closed
DeviceAllow=/dev/net/tun rw

[Install]
WantedBy=multi-user.target
