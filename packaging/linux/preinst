#!/bin/sh
set -eu
case "${1:-}" in
  install|upgrade)
    # Do not overwrite an administrator's file or unpack through a foreign
    # symlink. These fixed drop-ins make supported network managers depend on
    # successful early guard restoration. Guard-off restoration returns success.
    python3 - <<'PY'
from pathlib import Path
import stat
body=b'[Unit]\nRequires=moth-egress-guard.service\nAfter=moth-egress-guard.service\n'
for name in ('NetworkManager','systemd-networkd'):
    parent=Path('/usr/lib/systemd/system')/(name+'.service.d')
    path=parent/'50-moth-egress-guard.conf'
    for node in (parent,path):
        if node.exists() or node.is_symlink():
            info=node.lstat()
            if node.is_symlink() or info.st_uid!=0 or info.st_mode & 0o022:
                raise SystemExit('Unsafe or foreign Moth network-manager drop-in; installation stopped.')
    if path.exists() and (not path.is_file() or path.read_bytes()!=body):
        raise SystemExit('Moth network-manager drop-in was modified externally; installation stopped.')
PY
    if [ ! -d /run/systemd/system ]; then
      echo 'Moth Desktop requires a booted systemd system.' >&2
      exit 1
    fi
    if pgrep -x moth-desktop >/dev/null; then
      echo 'Exit Moth Desktop before installing or upgrading the package.' >&2
      exit 1
    fi
    if [ -e /run/moth-desktop/network-v1.json ] || [ -e /sys/class/net/moth0 ]; then
      echo 'Disconnect VPN and complete network recovery before installing Moth Desktop.' >&2
      exit 1
    fi
    if systemctl is-active --quiet moth-desktop.service; then
      # Execute only the previous root-owned fixed installation, and require an
      # authenticated status response before stopping/unpacking anything.
      /usr/lib/moth-desktop/moth-service --check-installed
      /usr/lib/moth-desktop/moth-service --tunnel-status | python3 -c '
import json,sys
state=json.load(sys.stdin)
if state.get("kind") != "tunnel" or state.get("phase") not in ("disconnected","failed"):
    raise SystemExit("Disconnect VPN before upgrading Moth Desktop, including connections owned by other users.")
'
      systemctl stop moth-desktop.service
    fi
    ;;
esac
exit 0
